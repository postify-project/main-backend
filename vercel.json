{
  "version": 2,
  "builds": [
    {
      "src": "src/app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/app.js"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/auto-reply?secret=${CRON_SECRET}",
      "schedule": "*/10 * * * *"
    }
  ]
}